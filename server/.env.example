# REVIVE AI - Backend Express API Environment Variables Example
# Copy this file to .env for development/production configuration

# Server Port
PORT=5000

# Environment Mode: development | production
NODE_ENV=development

# MongoDB Connection URI (Required in production, fallback to in-memory in dev)
MONGODB_URI=mongodb://localhost:27017/revive_ai

# Frontend Client URL (For CORS authorization)
CLIENT_URL=http://localhost:5173
